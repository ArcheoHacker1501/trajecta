QMainWindow, QWidget {
    background-color: #14171c;
    color: #e4e7ec;
    font-size: 14px;
}

QToolTip {
    background-color: #22272f;
    color: #e4e7ec;
    border: 1px solid #333a44;
    border-radius: 6px;
    padding: 6px 9px;
}

/* ---------- Top bar (brand + tabs) ---------- */

QFrame#TopBar {
    background-color: #1a1e24;
    border: none;
    border-bottom: 1px solid #262b33;
}

QFrame#TopBar QLabel {
    background: transparent;
}

QLabel#TopBarTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #eef1f5;
}

QLabel#TopBarVersion {
    color: #69717b;
    font-size: 12px;
    letter-spacing: 1px;
    padding-top: 3px;
}

/* Horizontal navigation tabs */
QPushButton#TabButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 9px 22px;
    font-size: 14px;
    color: #99a1ac;
}

QPushButton#TabButton:hover {
    background-color: #22272f;
    color: #e4e7ec;
}

QPushButton#TabButton:checked {
    background-color: #1e2a28;
    color: #a8d0c8;
}

/* ---------- Bottom status bar ---------- */

QFrame#StatusBar {
    background-color: #1a1e24;
    border: none;
    border-top: 1px solid #262b33;
}

QFrame#StatusBar QLabel {
    background: transparent;
    font-size: 12px;
}

QLabel#EnvStatus {
    font-size: 13px;   /* matches LinkButton, on the same status bar row */
    padding: 0 2px;
}

QLabel#StatusDivider {
    color: #333a44;
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: #7ea8a0;
    text-align: left;
    padding: 3px 6px;
    font-size: 13px;
}

QPushButton#LinkButton:hover {
    color: #93bcb3;
    text-decoration: underline;
}

/* ---------- Cards ---------- */

QFrame#Card {
    background-color: #1b1f26;
    border: 1px solid #282d36;
    border-radius: 12px;
}

QFrame#Card QWidget {
    background-color: transparent;
}

QLabel#CardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #eef1f5;
}

QLabel#CardSubtitle {
    color: #99a1ac;
    font-size: 13px;
}

QLabel#FieldLabel {
    color: #b6bec9;
    font-size: 13px;
    min-width: 120px;
}

QLabel#FieldLabel:disabled {
    color: #5c646e;
}

QLabel#HelpDot {
    color: #8a929d;
    background-color: #22272f;
    border: 1px solid #3a414b;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#HelpDot:hover {
    color: #d7e6e2;
    border-color: #7ea8a0;
}

QLabel#HelpDot:disabled {
    color: #4a525c;
    border-color: #2a2f38;
}

/* Explicit, not left to "QFrame#Card QWidget" further down this sheet: that
   rule is what has kept this label transparent everywhere it has been used
   until now, purely because every one of those places happens to sit inside
   a card. LargePagesOption (see largepages.cpp) does not — it lives on a
   bare Advanced settings page — and there the generic "QMainWindow, QWidget"
   background at the very top of this sheet showed through as a grey pill
   behind the text instead. A label is never meant to paint one of its own,
   in a card or out of it. */
QLabel#HintLabel {
    background: transparent;
    color: #79818c;
    font-size: 12px;
}

/* The strip the "Add chunk" button sits on. It spans the page between two
   cards, and as an ordinary QWidget it painted the opaque window colour across
   that whole width — a bare band, most obvious on Washi where the artwork
   behind is interrupted by it. Transparent, only the button itself carries a
   background. */
QWidget#AddChunkRow {
    background: transparent;
}

/* The column the chunks are stacked in. Same story, and worse: it spans every
   chunk on the page, so its opaque rectangle became a single slab with the
   chunk cards printed on it — the gaps between them filled in, and on Washi the
   cards' own translucency spent on that slab instead of on the artwork. Each
   chunk is a card in its own right and has to sit on the page like one. */
QWidget#ChunkHost {
    background: transparent;
}

/* What a "?" badge opens on a click. Shaped like a card, because that is what
   every other panel of explanation in the application looks like, and it is a
   popup rather than a tooltip so it stays on screen while it is read. */
QFrame#HelpPopup {
    background-color: #1b1f26;
    border: 1px solid #3a414b;
    border-radius: 12px;
}

QLabel#HelpPopupText {
    background: transparent;
    color: #e4e7ec;
    font-size: 13px;
}

/* ---------- The status bar's run ticker ----------
   A miniature of the run panel: the same chip, the same bar, the same colours.
   Only the measurements are new, and they are here rather than in the widget so
   a theme that changes the interface font can still change its size with it. */
QWidget#RunTicker,
QWidget#RunTicker QLabel {
    background: transparent;
}

QLabel#StateChip[mini="true"] {
    border-radius: 9px;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 2px 10px;
    min-width: 0px;
}

QLabel#TickerKind {
    color: #b6bec9;
    font-size: 12px;
    font-weight: 600;
}

QProgressBar#MiniProgress {
    border-radius: 9px;
    font-size: 10px;
}

QProgressBar#MiniProgress::chunk {
    border-radius: 8px;
}

/* Paused: the same bar, washed out. It is the treatment the interface already
   gives a control that is there but cannot do anything, which is exactly what a
   paused run is — and it reads at a glance, before the chip beside it is. */
QProgressBar#MiniProgress[paused="true"] {
    color: #5c646e;
}

QProgressBar#MiniProgress[paused="true"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2f3a38, stop:1 #6b7d79);
}

/* The drawer the ticker opens: three lines, rolled up out of the bar. */
QFrame#TickerDrawer {
    background-color: #1b1f26;
    border: 1px solid #3a414b;
    border-radius: 12px;
}

QLabel#TickerDrawerLine {
    background: transparent;
    color: #b6bec9;
    font-size: 12px;
}

/* ---------- Guided walkthrough ----------
   Only colours the palette table already carries, so all eight themes dress the
   tour without a single new entry in ThemeManager. */

QFrame#TourCallout {
    background-color: #1a1e24;
    border: 1px solid #2a2f38;
    border-radius: 12px;
}

QLabel#TourTitle {
    color: #eef1f5;
    font-size: 17px;
    font-weight: 600;
    background: transparent;
}

QLabel#TourBody {
    color: #b6bec9;
    font-size: 14px;
    background: transparent;
}

/* The way back, at the left end of the callout's button row. Outlined and not
   filled: it is plainly a button — same height and same corner as Continue —
   but the empty middle says which of the two the screen expects. */
QPushButton#TourBackButton {
    background: transparent;
    border: 1px solid #3a414b;
    border-radius: 10px;
    color: #b6bec9;
    font-size: 14px;
    font-weight: 600;
    padding: 0 12px;
}

QPushButton#TourBackButton:hover {
    border-color: #5c646e;
    color: #eef1f5;
}

QPushButton#TourBackButton:pressed {
    background-color: #22272f;
    color: #d3dae2;
}

QToolButton#TourClose {
    color: #99a1ac;
    background: transparent;
    border: none;
    font-size: 15px;
    padding: 2px 6px;
}

QToolButton#TourClose:hover {
    color: #e4e7ec;
}

QFrame#TourNavBar {
    background-color: #1a1e24;
    border: 1px solid #2a2f38;
    border-radius: 18px;
}

/* No vertical padding at all, and a fixed size set in walkthrough.cpp: the
   chevron is then centred in a square by the style, instead of being pushed
   off-centre by padding that the glyph's own bearing does not balance. */
QToolButton#TourNavButton {
    color: #d3dae2;
    background: transparent;
    border: none;
    font-size: 26px;
    padding: 0;
}

QToolButton#TourNavButton:hover {
    color: #eef1f5;
}

QToolButton#TourNavButton:disabled {
    color: #4a525c;
}

QLabel#TourCounter {
    color: #99a1ac;
    font-size: 13px;
    background: transparent;
}

/* ---------- Mode cards ---------- */

QPushButton#ModeCard {
    background-color: #171b21;
    border: 1px solid #2a2f38;
    border-radius: 12px;
    padding: 12px 16px;
    text-align: center;
    font-size: 15px;
    color: #b6bec9;
}

QPushButton#ModeCard:hover {
    border-color: #3a414b;
    background-color: #1c2128;
    color: #e4e7ec;
}

/* Filled, not tinted: with three cards side by side a faint wash was not
   enough to say which one is selected at a glance. #12211e is the palette's
   "text drawn on the accent", so it inverts with the accent on light themes. */
QPushButton#ModeCard:checked {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
    font-weight: 600;
}

QPushButton#ModeCard:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

/* One rule per mode, all currently set to the accent.

   The cards used to carry a colour each — the fill alone said which analysis
   was selected rather than only "one of the three is". That was dropped as a
   look, not as a mechanism: every rule below is still here, still targeting its
   own [mode], and still overriding the base :checked. Only the values changed.
   Restoring the coloured cards is five hex edits — lcpa #c9905a, batch #a58bd0,
   nni #d3a25e, compare #cf7f7f, coherence #7fb08a — and nothing else.
   The same property is set on the FETE/LCPA switch inside batch processing,
   which is the same choice made in a smaller place. */
QPushButton#ModeCard[mode="lcpa"]:checked,
QPushButton#ModeCard[mode="lcpa"]:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

QPushButton#ModeCard[mode="batch"]:checked,
QPushButton#ModeCard[mode="batch"]:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

/* The post-processing page picks a tool the same way, and used to borrow the
   analysis colours — so the same green meant "FETE" on one page and "NNI" on
   the other. These two are the palettes' "running" and "failed" signal
   colours, taken for their hue only: every theme already defines them
   light-on-dark or dark-on-light exactly as the accent is, so they fill
   correctly everywhere. Blue and rose are the two furthest from the analysis
   trio (teal, orange, violet) and from each other — which is the whole job of
   the colour here. */
/* Amber, not the paused blue it used to wear: on the light themes that blue
   came out as a deep navy, near enough to the accent that the two pages read
   as the same colour. This is the palettes' "running" tone — a medium-dark
   yellow on paper, a warm amber on the dark themes — and it is the one signal
   colour no other card on either page uses. */
QPushButton#ModeCard[mode="nni"]:checked,
QPushButton#ModeCard[mode="nni"]:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

QPushButton#ModeCard[mode="compare"]:checked,
QPushButton#ModeCard[mode="compare"]:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

/* The third tool on that page. Its rule is kept for the same reason as the
   others above: the structure outlives the colour choice. */
QPushButton#ModeCard[mode="coherence"]:checked,
QPushButton#ModeCard[mode="coherence"]:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

/* The fourth card on the post-processing page — Batch processing, offered
   there the same way it is on Processing — and, for the same reason as
   "lcpa"/"batch" above, the same property on the NNI/Compare/Coherence
   switch inside that batch page. */
QPushButton#ModeCard[mode="postbatch"]:checked,
QPushButton#ModeCard[mode="postbatch"]:checked:hover {
    border-color: #7ea8a0;
    background-color: #7ea8a0;
    color: #12211e;
}

QPushButton#ModeCard:disabled {
    color: #5c646e;
}

QPushButton#ModeCard:checked:disabled {
    background-color: #2f3a38;
    border-color: #2f3a38;
    color: #6b7d79;
}

/* ---------- Inputs ---------- */

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0f1216;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: #7ea8a0;
    selection-color: #12211e;
    color: #e4e7ec;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #7ea8a0;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #5c646e;
    border-color: #21262e;
}

/* The arrow is painted by SmoothComboBox so it can rotate; the style must not
   draw its own on top. The drop-down zone stays, to keep the text clear of it
   (its width matches kArrowZoneWidth in smoothcombobox.cpp). */
QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
}

/* The breathing room goes on the items, never on the view: Qt sizes the popup
   as (row height x row count) and does not know about padding applied to the
   list itself, so padding here makes the last row clipped and puts a scroller
   under a list that would otherwise fit. On ::item it is part of the row
   height, and the arithmetic comes out right. */
QComboBox QAbstractItemView {
    background-color: #1b1f26;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    selection-background-color: #1e2a28;
    selection-color: #d7e6e2;
    outline: none;
    padding: 0;
}

/* No margin here to inset the highlight: Qt ignores margin on ::item for item
   views, so it would be a rule that reads as if it did something. The rounded
   silhouette comes from the mask applied in SmoothComboBox::showPopup(), which
   clips the highlight at the corners too. */
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border: none;
    min-height: 20px;
}

/* :selected covers the lists whose view moves the highlight with the mouse;
   :hover covers any that draw a separate hover state. Both get the same teal,
   so no list can end up highlighting in the style's own colour. */
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #1e2a28;
    color: #d7e6e2;
}

/* A list long enough to scroll (only the Viewer's layer list, which is capped)
   gets stepper buttons: the arrow the style draws in them is the visible cue
   that there is more below. The app-wide scrollbar rule removes those buttons,
   so they have to be given a height back here. */
QComboBox QAbstractItemView QScrollBar:vertical {
    background: transparent;
    width: 14px;
    margin: 0;
}

QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background: #3a414b;
    border-radius: 3px;
    min-height: 24px;
    margin: 0 4px;
}

QComboBox QAbstractItemView QScrollBar::handle:vertical:hover {
    background: #4a525c;
}

QComboBox QAbstractItemView QScrollBar::sub-line:vertical,
QComboBox QAbstractItemView QScrollBar::add-line:vertical {
    background: transparent;
    border: none;
    height: 12px;
    subcontrol-origin: margin;
}

QComboBox QAbstractItemView QScrollBar::sub-line:vertical {
    subcontrol-position: top;
}

QComboBox QAbstractItemView QScrollBar::add-line:vertical {
    subcontrol-position: bottom;
}

/* Styling a sub-control makes the style stop drawing its own version of it: the
   moment ::up-button got a background, the arrow inside it vanished — the
   buttons kept working, they just had nothing in them. Qt only puts an arrow
   back through an image, and a resource SVG carries a baked fill that the
   palette map cannot rewrite, so %ARROW_UP% / %ARROW_DOWN% are substituted by
   ThemeManager::apply() with triangles drawn in the accent's foreground. The
   buttons themselves carry the same teal as the Run Analysis button. */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background-color: #7ea8a0;
    border: none;
    border-top-right-radius: 7px;
    width: 20px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background-color: #7ea8a0;
    border: none;
    border-bottom-right-radius: 7px;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #93bcb3;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #6b968f;
}

QSpinBox::up-button:disabled, QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled, QDoubleSpinBox::down-button:disabled {
    background-color: #2f3a38;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(%ARROW_UP%);
    width: 9px;
    height: 6px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(%ARROW_DOWN%);
    width: 9px;
    height: 6px;
}

/* ---------- Checkboxes & group boxes ---------- */

/* outline: none suppresses the style's own native focus rectangle — a
   plain rounded-grey box drawn around the whole label, not just the little
   indicator, and never styled to match anything else here. Barely visible
   on the dark themes, where its grey is close enough to the page behind it,
   but a clear stray box on Light — first noticed on Large memory pages'
   checkbox (largepages.cpp), the one most likely to hold keyboard focus the
   moment a dialog built on it opens. Keyboard focus still has its own
   indication: the indicator recolours to the accent below, the same as
   hovering it. */
QCheckBox {
    spacing: 8px;
    color: #e4e7ec;
    outline: none;
}

QCheckBox::indicator, QGroupBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a414b;
    border-radius: 5px;
    background-color: #0f1216;
}

QCheckBox::indicator:hover, QGroupBox::indicator:hover,
QCheckBox::indicator:focus, QGroupBox::indicator:focus {
    border-color: #7ea8a0;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background-color: #7ea8a0;
    border-color: #7ea8a0;
}

QGroupBox {
    border: none;
    margin-top: 8px;
    font-weight: 600;
    color: #e4e7ec;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 24px;
    top: 0px;
    padding: 3px 2px;
}

/* ---------- Buttons ---------- */

QPushButton {
    background-color: #22272f;
    border: 1px solid #333a44;
    border-radius: 8px;
    padding: 8px 16px;
    color: #e4e7ec;
}

QPushButton:hover {
    background-color: #272d36;
    border-color: #3f4753;
}

QPushButton:pressed {
    background-color: #1c2128;
}

QPushButton:disabled {
    color: #5c646e;
    background-color: #191d23;
    border-color: #242932;
}

/* The strip a run button sits on, between two cards. Same story as
   QWidget#AddChunkRow further up: the post-processing rows exist as widgets
   rather than as bare layouts, because a whole row has to be shown and hidden
   with the tool it belongs to — and an ordinary QWidget is caught by the
   "QMainWindow, QWidget" rule at the top of this file, which painted the
   opaque window colour clear across the page. "Run analysis" never had the
   problem: it is added as a layout, so there is no widget of its own to paint.
   Transparent here, and only the button carries a background. */
QWidget#RunRow {
    background: transparent;
}

QPushButton#RunButton {
    background-color: #7ea8a0;
    border: none;
    color: #10201d;
    font-size: 16px;
    font-weight: 700;
    border-radius: 10px;
}

QPushButton#RunButton:hover {
    background-color: #93bcb3;
}

QPushButton#RunButton:pressed {
    background-color: #6b968f;
}

QPushButton#RunButton:disabled {
    background-color: #2f3a38;
    color: #6b7d79;
}


/* Same solid fill as the run buttons, one size down: an outlined button was
   too faint to find on the light themes.
   Every selector here names the Card ancestor as well. This button is the one
   run button that sits inside a card, and "QFrame#Card QWidget" above is more
   specific than a bare "#SecondaryRunButton" — without the qualified form the
   fill is silently dropped and only the text shows. */
QPushButton#SecondaryRunButton,
QFrame#Card QPushButton#SecondaryRunButton {
    background-color: #7ea8a0;
    border: none;
    border-radius: 9px;
    color: #10201d;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#SecondaryRunButton:hover,
QFrame#Card QPushButton#SecondaryRunButton:hover {
    background-color: #93bcb3;
}

QPushButton#SecondaryRunButton:pressed,
QFrame#Card QPushButton#SecondaryRunButton:pressed {
    background-color: #6b968f;
}

/* Outlined when disabled, and deliberately in the hint tokens rather than the
   muted-surface ones: #2f3a38 and friends are dark-theme greys that every
   light palette maps to near-white, which left the button invisible on paper
   backgrounds. #79818c is the hint colour, readable on both. */
QPushButton#SecondaryRunButton:disabled,
QFrame#Card QPushButton#SecondaryRunButton:disabled {
    background-color: transparent;
    border: 1px solid #79818c;
    color: #79818c;
}

/* Gear button and its theme menu (top bar, far right) */

QToolButton#GearButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 4px;
    color: #99a1ac;
}

QToolButton#GearButton:hover {
    background-color: #22272f;
    color: #d7e6e2;
}

QToolButton#GearButton::menu-indicator {
    image: none;
    width: 0;
}

/* ---------- Window controls (native title bar replacement) ---------- */

QToolButton#WindowButton, QToolButton#WindowCloseButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px;
    min-width: 20px;
    min-height: 20px;
}

QToolButton#WindowButton:hover {
    background-color: #22272f;
}

QToolButton#WindowButton:pressed {
    background-color: #1c2128;
}

/* Only the close button turns red, the convention everywhere else. */
QToolButton#WindowCloseButton:hover {
    background-color: #e1281e;
}

/* Darker than the hover, and already in the palette table so it follows every
   theme. A colour not in that table would stay dark-red on a light theme. */
QToolButton#WindowCloseButton:pressed {
    background-color: #5c3a3e;
}

QMenu {
    background-color: #1b1f26;
    border: 1px solid #2a2f38;
    border-radius: 10px;
    padding: 6px;
    color: #e4e7ec;
}

QMenu::item {
    padding: 7px 26px 7px 30px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #1e2a28;
    color: #d7e6e2;
}

QMenu::item:disabled {
    color: #69717b;
}

QMenu::separator {
    height: 1px;
    background: #2a2f38;
    margin: 5px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 9px;
}

/* ---------- The three button roles ----------

   Primary: an ordinary action — add, duplicate, move, save, pause. Filled in
   the accent, like the run buttons, one size down.
   Danger:  an action that throws work away — delete, skip, stop, cancel.
   Filled in the palette's amber rather than its red: red is reserved for
   "this failed", and these buttons are offered, not warnings.
   Plain QPushButton: everything else.

   Every selector names the Card ancestor too. "QFrame#Card QWidget" earlier in
   this sheet is more specific than a bare "#Name", and without the qualified
   form the fill is silently dropped inside a card and only the text shows. */

QPushButton#PrimaryButton,
QFrame#Card QPushButton#PrimaryButton {
    background-color: #7ea8a0;
    border: 1px solid #7ea8a0;
    color: #12211e;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover,
QFrame#Card QPushButton#PrimaryButton:hover {
    background-color: #93bcb3;
    border-color: #93bcb3;
}

QPushButton#PrimaryButton:pressed,
QFrame#Card QPushButton#PrimaryButton:pressed {
    background-color: #6b968f;
    border-color: #6b968f;
}

/* Outlined in the hint colour when disabled: the dark-theme muted surfaces map
   to near-white on the paper palettes and left the button invisible there. */
QPushButton#PrimaryButton:disabled,
QFrame#Card QPushButton#PrimaryButton:disabled {
    background-color: transparent;
    border: 1px solid #79818c;
    color: #79818c;
}

/* Red, and the same red on every theme. These four literals appear nowhere in
   ThemeManager's colour table, so the palette substitution leaves them alone —
   which is the point: "this button throws work away" has to read identically
   whichever theme is on, and the amber this used to inherit from each palette
   said "careful" where it needed to say "stop". Contrast against white text is
   7.0:1 on the fill, so it stays legible on the paper themes too. */
QPushButton#DangerButton,
QFrame#Card QPushButton#DangerButton {
    background-color: #e1281e;
    border: 1px solid #e1281e;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#DangerButton:hover,
QFrame#Card QPushButton#DangerButton:hover {
    background-color: #e1281e;
    border-color: #e1281e;
    color: #ffffff;
}

QPushButton#DangerButton:pressed,
QFrame#Card QPushButton#DangerButton:pressed {
    background-color: #8f1d17;
    border-color: #8f1d17;
    color: #ffffff;
}

QPushButton#DangerButton:disabled,
QFrame#Card QPushButton#DangerButton:disabled {
    background-color: transparent;
    border: 1px solid #79818c;
    color: #79818c;
}

/* The fold handle in the bottom-right corner of a chunk. */
QToolButton#CollapseHandle,
QFrame#Card QToolButton#CollapseHandle {
    background: transparent;
    border: none;
    padding: 2px 8px;
    color: #7ea8a0;
    font-size: 13px;
}

QToolButton#CollapseHandle:hover,
QFrame#Card QToolButton#CollapseHandle:hover {
    color: #a8d0c8;
    background-color: #1e2a28;
    border-radius: 6px;
}

QToolButton {
    background-color: #22272f;
    border: 1px solid #333a44;
    border-radius: 7px;
    padding: 6px 12px;
    color: #e4e7ec;
}

QToolButton:hover {
    background-color: #272d36;
}

/* ---------- Run page ---------- */

QLabel#StateChip {
    border-radius: 13px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 0 14px;
    background-color: #22272f;
    color: #99a1ac;
}

QLabel#StateChip[state="running"] {
    background-color: #2f2a17;
    color: #d3a25e;
}

QLabel#StateChip[state="paused"] {
    background-color: #1e2733;
    color: #7f9cc4;
}

QLabel#StateChip[state="success"] {
    background-color: #1e2a24;
    color: #7fb08a;
}

QLabel#StateChip[state="failed"] {
    background-color: #2a2022;
    color: #cf7f7f;
}

QLabel#PhaseLabel {
    color: #99a1ac;
    font-size: 13px;
}

QLabel#ElapsedLabel {
    color: #e4e7ec;
    font-size: 14px;
    font-weight: 600;
    font-family: "Consolas";
}

QProgressBar {
    background-color: #0f1216;
    border: 1px solid #282d36;
    border-radius: 9px;
    text-align: center;
    color: #e4e7ec;
    font-size: 12px;
    font-weight: 600;
}

QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5c847d, stop:1 #7ea8a0);
}

QPlainTextEdit#Console {
    background-color: #0d0f13;
    border: 1px solid #262b33;
    border-radius: 10px;
    padding: 8px;
    color: #d3dae2;
}

QLabel#SummaryBody {
    color: #b6bec9;
    font-size: 13px;
}

/* ---------- Viewer ---------- */

/* Map canvas. The rounded background and border live on the holder, which is
   the widget that stays put whether the map or the "no raster" placeholder is
   on top; the view itself draws nothing of its own. Card colours, not a
   near-black of its own, so the canvas reads as one more panel of the page —
   opaque, though, since a map needs a solid backing. */
/* While layers are being dragged over the Viewer. The accent, and a dashed
   edge: the canvas says "let go here" without a word being written on it. */
QFrame#CanvasHolder[dropTarget="true"] {
    border: 1px dashed #7ea8a0;
}

QFrame#CanvasHolder {
    background-color: #1b1f26;
    border: 1px solid #282d36;
    border-radius: 12px;
}

QFrame#CanvasHolder QLabel {
    background: transparent;
}

/* The plain widget the map/placeholder stack lives in. As an ordinary QWidget
   it painted the opaque generic background across the holder's whole interior
   — the same slab AddChunkRow and ChunkHost had, and here it hid the card
   colour the holder itself is styled with, showing as a flat grey square (a
   near-white one on the paper themes) instead of the map's own panel. */
QWidget#CanvasArea {
    background: transparent;
}

/* The line under the map that says which CRS, which resolution and what is
   under the pointer. It lives inside the panel now, so it must not paint the
   window colour across the bottom of it. */
QWidget#CanvasInfoRow {
    background: transparent;
}

/* Opaque, and the same colour as the holder behind it. A transparent
   QGraphicsView would push every repaint up to the window background. */
QGraphicsView#ViewerCanvas {
    background-color: #1b1f26;
    border: none;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #22272f;
    border: 1px solid #333a44;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #7ea8a0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #e4e7ec;
    border: 2px solid #7ea8a0;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 7px;
}

QWidget#OverlayPanel {
    background-color: #1b1f26;
    border: 1px solid #333a44;
    border-radius: 9px;
}

/* Same weight and size as the field labels beside it (Layer, Color scale,
   Filter); no font-family, so it follows whatever the UI font is set to. */
QLabel#OverlayPanelTitle {
    color: #b6bec9;
    font-size: 14px;
    font-weight: 400;
    background: transparent;
    padding-bottom: 2px;
}

QWidget#OverlayPanel QCheckBox {
    font-size: 13px;
    background: transparent;
}

QWidget#OverlayPanel QWidget {
    background: transparent;
}

/* The per-feature information panel, bottom right. Deliberately identical to
   the Overlays panel on the opposite corner: both are small panes floating over
   the map, and the outline is what lifts them off the raster behind. */
QFrame#FeaturePanel {
    background-color: #1b1f26;
    border: 1px solid #333a44;
    border-radius: 9px;
}

QFrame#FeaturePanel QWidget {
    background: transparent;
}

/* The colour wheel opened by right-clicking a row in the Overlays panel. Same
   pane, same outline, same reason: a real top-level popup is not guaranteed
   to be repainted by the compositor over this window's own custom-drawn
   frame, so this one lives inside the window like every other floating panel
   here — see uiwidgets.cpp. */
QFrame#ColourWheelPanel {
    background-color: #1b1f26;
    border: 1px solid #333a44;
    border-radius: 10px;
}

QFrame#ColourWheelPanel QWidget {
    background: transparent;
}

/* The bin for an imported vector. Quiet until the pointer is on it: the panel
   is a legend first, and a row of buttons would read as the point of it. */
QToolButton#OverlayRemove {
    color: #69717b;
    background: transparent;
    border: none;
    padding: 0px 2px;
    font-size: 15px;
}

QToolButton#OverlayRemove:hover {
    color: #e4e7ec;
}

/* ---------- Guide & About ---------- */

QTextBrowser#GuideBrowser {
    background-color: #1b1f26;
    border: 1px solid #282d36;
    border-radius: 12px;
    padding: 16px;
    font-size: 14px;
}

QLabel#AboutTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #eef1f5;
}

/* The Overview page's stand-in for the <h2> every other guide page opens
   with — same teal as %H2% in the guide's own <style> block substitution. */
QLabel#GuideOverviewTitle {
    font-size: 22px;
    font-weight: 700;
    color: #a8d0c8;
}

QLabel#AboutBody {
    font-size: 14px;
    color: #b6bec9;
}

/* ---------- Tab widget (generic, for consistency) ---------- */

QTabWidget::pane {
    border: 1px solid #282d36;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #99a1ac;
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    margin-right: 4px;
}

QTabBar::tab:hover {
    background-color: #22272f;
    color: #e4e7ec;
}

QTabBar::tab:selected {
    background-color: #1e2a28;
    color: #a8d0c8;
    font-weight: 600;
}

/* ---------- Scrollbars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #2e343d;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3a414b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #2e343d;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a414b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollArea {
    border: none;
}

/* ---------- Message boxes ---------- */

QMessageBox {
    background-color: #1b1f26;
}

/* Without this the label paints the generic QWidget background (#14171c) as an
   opaque box on top of the box's own #1b1f26. */
QMessageBox QLabel {
    background: transparent;
    color: #e4e7ec;
}

/* The GitHub link on the About page. Quiet until it is pointed at, like a link
   rather than a command: the page is a colophon, not a form. Qualified with the
   card, for the same reason as #SecondaryRunButton — "QFrame#Card QWidget" is
   more specific than a bare object name and would otherwise win. */
QPushButton#GithubButton,
QFrame#Card QPushButton#GithubButton {
    background: transparent;
    border: 1px solid #333a44;
    border-radius: 8px;
    padding: 7px 16px;
    color: #e4e7ec;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#GithubButton:hover,
QFrame#Card QPushButton#GithubButton:hover {
    background-color: #22272f;
    border-color: #3f4753;
}

QPushButton#GithubButton:pressed,
QFrame#Card QPushButton#GithubButton:pressed {
    background-color: #1c2128;
}

/* ---------- Guide: the page list and the section list ----------
   The Guide is a small site: pages on the left, the document in the middle,
   the current page's sections on the right.

   The selected row's background is deliberately NOT set here. GuideNav paints
   it itself, sliding it from the old row to the new one — Qt stylesheets have
   no transitions, so a rule here would make the selection jump instead. All
   this sheet contributes to the current row is the text colour, which the
   painted mark sits behind. */
QListWidget#GuideSidebar {
    background: transparent;
    border: none;
    border-right: 1px solid #262b33;
    padding: 4px 8px 4px 0px;
    outline: none;
    font-size: 13px;
}

QListWidget#GuideSidebar::item {
    padding: 9px 12px;
    border: none;
    color: #b6bec9;
}

QListWidget#GuideSidebar::item:hover {
    color: #e4e7ec;
}

QListWidget#GuideSidebar::item:selected {
    background: transparent;
    color: #7ea8a0;
    font-weight: 600;
}

/* The right-hand column. Quieter than the page list by a step: it is a way of
   moving inside what you are already reading, not a way of choosing what to
   read, and giving the two the same weight made the page look like it had two
   navigations of equal importance.

   The divider and the inset live on the panel now, not on the list inside
   it, so the "On this page" caption sits under the same line and at the same
   indent as the sections below it, instead of the list alone owning them. */
QFrame#GuideTocPanel {
    background: transparent;
    border: none;
    border-left: 1px solid #262b33;
}

QLabel#GuideTocTitle {
    background: transparent;
    color: #79818c;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

QListWidget#GuideToc {
    background: transparent;
    border: none;
    outline: none;
    font-size: 12px;
}

QListWidget#GuideToc::item {
    padding: 5px 8px;
    border: none;
    border-left: 2px solid transparent;
    color: #79818c;
}

QListWidget#GuideToc::item:hover {
    color: #e4e7ec;
    border-left-color: #333a44;
}

QListWidget#GuideToc::item:selected {
    background: transparent;
    color: #7ea8a0;
    border-left-color: #7ea8a0;
}

/* The Overview page's scroller and the widget inside it: both would otherwise
   be caught by the generic "QMainWindow, QWidget" rule at the top of this
   sheet and paint the window colour over the page. */
QScrollArea#GuideOverviewScroll,
QWidget#GuideOverviewHost {
    background: transparent;
    border: none;
}

/* ---------- Frameless dialog title bar ---------- */
/* Every dialog built on FramelessDialog (see framelessdialog.cpp) carries
   this row instead of a native title bar: a name and a single close button —
   #WindowCloseButton, the same rule the main window's own close button uses,
   a few sections down. Background transparent rather than a colour of its
   own: the dialog underneath already carries the right one (#1b1f26, on
   #ConfirmDialog and every dialog that reuses its shape), and repeating it
   here would only risk the two drifting apart later. */
QWidget#FramelessTitleBar {
    background: transparent;
    border-bottom: 1px solid #262b33;
}

QLabel#FramelessTitleLabel {
    background: transparent;
    color: #eef1f5;
    font-size: 14px;
    font-weight: 600;
}

/* ---------- Confirmation dialog (Yes/No) ---------- */

/* Fixed-size, icon-free replacement for QMessageBox::question, so every
   confirmation in the app is the same shape. See confirmdialog.cpp.

   Written twice on purpose. "QFrame#Card QWidget" up at the top of this sheet
   clears the background of everything inside a card, and it outranks a plain
   "QDialog#ConfirmDialog" — one id and two types against one id and one type.
   A dialog is matched by it whenever its parent lives in a card, however much a
   separate window it is, and a transparent top-level window renders black. The
   second selector ties on specificity and, being further down the sheet, wins.
   confirmdialog.cpp parents its dialogs to the window so this cannot arise; the
   line stays as the guard for whatever gets written next.

   Now inert in practice, like the equivalent rule on #AdvancedSettingsDialog
   above: confirm(), notify() and choose() all build on FramelessDialog, whose
   own paintEvent() paints this same colour directly rather than trust a
   stylesheet to reach a frameless top-level widget. Left in place for the
   same reason as there. */
QDialog#ConfirmDialog,
QWidget QDialog#ConfirmDialog {
    background-color: #1b1f26;
}

QLabel#ConfirmText {
    background: transparent;
    color: #e4e7ec;
    font-size: 14px;
}

/* ---- the report form ----
   Its dialog, buttons and instruction reuse #ConfirmDialog, #ConfirmButton and
   #ConfirmText; only the three pieces no confirmation has need rules of their
   own. The writing area is given the same fill, border and focus colour as
   every other input in the application, since that is what it is. */
QPlainTextEdit#ReportBody {
    background-color: #0f1216;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 8px 9px;
    selection-background-color: #7ea8a0;
    selection-color: #12211e;
    color: #e4e7ec;
    font-size: 13px;
}

QPlainTextEdit#ReportBody:focus {
    border-color: #7ea8a0;
}

/* The strip of attached screenshots. Same fill and border as the writing area
   above it, so the two read as one panel of things the user has provided. */
QListWidget#ReportShots {
    background-color: #0f1216;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 3px;
}

QListWidget#ReportShots::item {
    border: 1px solid transparent;
    border-radius: 6px;
    margin: 2px;
}

/* Selection has to be visible: it is what Remove acts on. */
QListWidget#ReportShots::item:selected {
    border-color: #7ea8a0;
    background-color: #1e2a28;
}

/* The field label and the line saying what travels with the report: secondary
   text, deliberately quieter than what the user is writing. */
QLabel#ReportMeta {
    background: transparent;
    color: #99a1ac;
    font-size: 12px;
}

/* "Sending...", and why it failed. Empty most of the time, so it must not
   reserve a coloured strip when it has nothing to say. */
QLabel#ReportStatus {
    background: transparent;
    color: #cf9a9a;
    font-size: 12px;
}

/* The horizontal padding is not decoration: with none, a button whose label is
   a verb rather than "Yes" comes out exactly as wide as the text, and "Start
   walkthrough" reads as a label someone drew a box around. */
QPushButton#ConfirmButton {
    background-color: #22272f;
    border: 1px solid #333a44;
    border-radius: 8px;
    padding: 9px 20px;
    color: #e4e7ec;
}

QPushButton#ConfirmButton:hover {
    background-color: #272d36;
    border-color: #3f4753;
}

QPushButton#ConfirmButton:pressed {
    background-color: #1c2128;
}

QPushButton#ConfirmButton:default {
    border-color: #3f4753;
}

/* The filled answer, for the confirmations where one of the two is plainly the
   better one (see confirmdialog.h). Restated for every state, and placed after
   the rules above, because equal specificity in QSS is settled by which rule
   comes last. */
QPushButton#ConfirmButton[fill="accent"],
QPushButton#ConfirmButton[fill="accent"]:default {
    background-color: #7ea8a0;
    border: 1px solid #7ea8a0;
    color: #10201d;
    font-weight: 600;
}

QPushButton#ConfirmButton[fill="accent"]:hover {
    background-color: #93bcb3;
    border-color: #93bcb3;
}

QPushButton#ConfirmButton[fill="accent"]:pressed {
    background-color: #6b968f;
    border-color: #6b968f;
}

/* The same mechanism again, for a button that has to read as destructive: the
   report form's Cancel. #DangerButton would give it the right colour and the
   wrong shape — that rule sets a fill and a border but no radius and no
   padding, so it inherits both from the generic QPushButton rule and comes out
   visibly unlike the Send button beside it. Going through #ConfirmButton keeps
   every measurement identical and changes only the colour. */
QPushButton#ConfirmButton[fill="danger"],
QPushButton#ConfirmButton[fill="danger"]:default {
    background-color: #e1281e;
    border: 1px solid #e1281e;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#ConfirmButton[fill="danger"]:hover {
    background-color: #ef3b31;
    border-color: #ef3b31;
}

QPushButton#ConfirmButton[fill="danger"]:pressed {
    background-color: #8f1d17;
    border-color: #8f1d17;
}

/* Unavailable, and it has to look it. A stylesheet that names a background and
   a colour overrides what Qt would otherwise grey out by itself, so without
   this a disabled button keeps its accent fill and reads as pressable while
   doing nothing — which is how the report form's Send button looked before its
   own state was styled. Both forms are listed: the accent rule above is more
   specific than a bare :disabled, and in QSS the more specific rule wins. */
QPushButton#ConfirmButton:disabled,
QPushButton#ConfirmButton[fill="accent"]:disabled {
    background-color: #22272f;
    border: 1px solid #2a2f38;
    color: #5c646e;
    font-weight: 400;
}

/* The same property, for a button with no object name of its own: the OK of
   the Viewer's export dialog, which comes out of a QDialogButtonBox. Written
   without an id so it never competes with the rules above, and with its own
   padding because a standard dialog button has none of the confirmation
   dialog's fixed width to fall back on. */
QPushButton[fill="accent"] {
    background-color: #7ea8a0;
    border: 1px solid #7ea8a0;
    border-radius: 8px;
    padding: 7px 22px;
    color: #10201d;
    font-weight: 600;
}

QPushButton[fill="accent"]:hover {
    background-color: #93bcb3;
    border-color: #93bcb3;
}

QPushButton[fill="accent"]:pressed {
    background-color: #6b968f;
    border-color: #6b968f;
}

/* ---------- Advanced settings dialog ----------
   Behind the gear menu's "Advanced settings…" entry. Wider than the plain
   Yes/No shape of #ConfirmDialog, so it gets an id and a sheet of its own
   rather than reusing that one — see advancedsettingsdialog.h. Written twice
   for the same reason as #ConfirmDialog above: "QFrame#Card QWidget" clears
   the background of everything inside a card and would otherwise outrank a
   bare "QDialog#AdvancedSettingsDialog" if this dialog is ever parented
   somewhere a card can reach it.

   Since both dialogs were rebuilt on FramelessDialog, neither rule below
   actually paints anything any more — a stylesheet does not reliably reach a
   frameless top-level widget (see the palette-rule note further down this
   file), which is exactly why FramelessDialog::paintEvent() now fills the
   same colour directly. Left in place regardless: it is what a future
   QDialog reusing either id, built the old way, would still need. */
QDialog#AdvancedSettingsDialog,
QWidget QDialog#AdvancedSettingsDialog {
    background-color: #1b1f26;
}

/* The sidebar list. Same fill as the header, so together they read as one
   frame the pages sit inside rather than a panel floating over another.
   Flush with the dialog's own left and bottom edges (see
   advancedsettingsdialog.cpp) — border-bottom-left-radius keeps that fill
   from squaring off the window's own rounded corner there. Same number as
   FramelessDialog::kCornerRadius; the two have to move together. */
QListWidget#AdvancedSettingsSidebar {
    background-color: #14171c;
    border: none;
    border-right: 1px solid #262b33;
    border-bottom-left-radius: 12px;
    padding: 8px 0px;
    outline: none;
    font-size: 13px;
}

QListWidget#AdvancedSettingsSidebar::item {
    padding: 10px 16px;
    border: none;
    color: #b6bec9;
}

QListWidget#AdvancedSettingsSidebar::item:hover {
    background-color: #1c2128;
}

QListWidget#AdvancedSettingsSidebar::item:selected {
    background-color: #1e2a28;
    color: #7ea8a0;
}

QStackedWidget#AdvancedSettingsPages,
QWidget#AdvancedSettingsPage {
    background: transparent;
}

QLabel#AdvancedSettingsPageTitle {
    background: transparent;
    color: #eef1f5;
    font-size: 15px;
    font-weight: 600;
}

QLabel#AdvancedSettingsPageIntro {
    background: transparent;
    color: #b6bec9;
    font-size: 13px;
}

/* The tick/status/"Set up…" row (see largepages.cpp) — otherwise an unnamed
   QWidget, caught by the generic "QMainWindow, QWidget" rule at the very top
   of this sheet and painted with the window's own background instead of the
   page's. */
QWidget#LargePagesOption {
    background: transparent;
}

/* The scroll area a page sits in, and its viewport — the plain QWidget
   QScrollArea makes for itself, one level above the page. Left unstyled it
   paints the opaque generic background (see CanvasArea in theme.qss), which
   here is the window colour rather than the dialog's own #1b1f26 and would
   have shown as a mismatched patch behind the scrolled text. ">" reaches the
   viewport specifically: the page itself is a grandchild, already
   transparent through the rule above. */
QScrollArea#AdvancedSettingsScroll {
    background: transparent;
    border: none;
}

QScrollArea#AdvancedSettingsScroll > QWidget {
    background: transparent;
}

/* ---------- Batch processing table ----------
   Every colour below already appears elsewhere in this sheet, so the palettes
   in thememanager.cpp map the table for free — no new entry in kDarkColors,
   and no risk of a cell staying dark on a light theme.

   The selectors are qualified with the card, for the same reason as
   #SecondaryRunButton above: "QFrame#Card QWidget" makes everything inside a
   card transparent and would otherwise win over a bare "#BatchTable". */
QFrame#Card QTableView#BatchTable {
    background-color: #0f1216;
    alternate-background-color: #0f1216;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    gridline-color: #282d36;
    color: #e4e7ec;
    selection-background-color: #1e2a28;
    selection-color: #a8d0c8;
}

QFrame#Card QTableView#BatchTable::item {
    padding: 2px 6px;
    border: none;
}

QFrame#Card QTableView#BatchTable::item:selected {
    background-color: #1e2a28;
    color: #a8d0c8;
}

/* The header is a shade lighter than the cells, the way the cards sit above
   the page background. */
QFrame#Card QTableView#BatchTable QHeaderView::section {
    background-color: #22272f;
    color: #b6bec9;
    border: none;
    border-right: 1px solid #282d36;
    border-bottom: 1px solid #282d36;
    padding: 6px 8px;
    font-size: 13px;
}

QFrame#Card QTableView#BatchTable QHeaderView::section:vertical {
    color: #69717b;
    border-right: 1px solid #282d36;
}

QFrame#Card QTableView#BatchTable QTableCornerButton::section {
    background-color: #22272f;
    border: none;
    border-right: 1px solid #282d36;
    border-bottom: 1px solid #282d36;
}

/* The editors opened inside a cell: no rounded corners or padding here, or
   they would not line up with the cell they replace. */
QFrame#Card QTableView#BatchTable QLineEdit,
QFrame#Card QTableView#BatchTable QSpinBox,
QFrame#Card QTableView#BatchTable QComboBox {
    border-radius: 0;
    padding: 2px 4px;
    background-color: #0f1216;
    border: 1px solid #7ea8a0;
}

QFrame#Card QTableView#BatchTable QToolButton {
    background-color: #22272f;
    border: 1px solid #333a44;
    border-radius: 4px;
    color: #e4e7ec;
    padding: 0px 6px;
}

QFrame#Card QTableView#BatchTable QToolButton:hover {
    background-color: #272d36;
}
